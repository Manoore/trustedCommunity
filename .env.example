# Database (docker-compose maps Postgres to host port 5433)
DATABASE_URL=postgresql://classifieds:classifieds@localhost:5433/classifieds

# Public site URL, used for absolute links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional). Without these, messages are written to the server log instead
# of being sent, so the app is fully usable without an account anywhere.
RESEND_API_KEY=
EMAIL_FROM=

# Phone verification over WhatsApp (WhatsApp Business Platform, Cloud API).
# Leave blank and codes are shown on screen in development, and the feature
# reports itself off in production. Needs a Meta app, a WhatsApp number and an
# approved AUTHENTICATION template (see README).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v23.0
# Require a verified number before adding recommendations, asks, groups or help posts.
REQUIRE_PHONE_VERIFICATION=false
# Most codes the whole site will send per day. Caps the bill if someone abuses it.
OTP_DAILY_CAP=300

# Healthcare and legal contact categories. Off by default: turn on only after a
# lawyer has read /legal/terms. When on, these are contact-only, notes are capped
# at 200 characters, and each new entry queues a licence check for the admin.
ENABLE_PROFESSIONAL_CATEGORIES=false

# Stripe (optional). Leave blank and featured-listing checkout stays disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=false

# Price in USD cents for a 30-day featured listing
FEATURED_LISTING_PRICE_CENTS=2900
FEATURED_LISTING_DAYS=30
